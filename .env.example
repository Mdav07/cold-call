# Copy to .env.local. Never commit real values. Testnet only.

# --- Arc testnet ---
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- Signer: "circle" or "viem" ---
SIGNER_MODE=viem

# Circle developer-controlled wallets (SIGNER_MODE=circle)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
HOUSE_CIRCLE_WALLET_ID=
BARRY_CIRCLE_WALLET_ID=
PENNY_CIRCLE_WALLET_ID=
DEE_CIRCLE_WALLET_ID=
ANNIE_CIRCLE_WALLET_ID=
BILL_CIRCLE_WALLET_ID=
CASSIUS_CIRCLE_WALLET_ID=
MAX_CIRCLE_WALLET_ID=

# Fallback keys (SIGNER_MODE=viem). Testnet keys only.
HOUSE_PRIVATE_KEY=
BARRY_PRIVATE_KEY=
PENNY_PRIVATE_KEY=
DEE_PRIVATE_KEY=
ANNIE_PRIVATE_KEY=
BILL_PRIVATE_KEY=
CASSIUS_PRIVATE_KEY=
MAX_PRIVATE_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shared secrets ---
# Sent by ElevenLabs server tools in the x-coldcall-tool-secret header
TOOL_SHARED_SECRET=
# Sent by the QuickNode Stream in the x-coldcall-stream-token header
STREAM_WEBHOOK_TOKEN=

# --- ElevenLabs (owner B) ---
ELEVENLABS_API_KEY=

# --- QuickNode ---
QUICKNODE_API_KEY=

# --- Limits (defaults in code if unset) ---
DAILY_BUDGET_CAP_MULTIPLE=20
RUNS_PER_USER_PER_DAY=10
RUNS_PER_IP_PER_DAY=30
TOKEN_PAYOUT_UNITS=10000
